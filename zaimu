// 業種セレクトの選択肢は、INDUSTRY_BENCHMARKS（実データ）を唯一の情報源として動的生成する。
// 業種を追加・変更したい場合はINDUSTRY_RAW_DATA.industriesを編集するだけでよく、
// このHTML側の<select>を直接編集する必要はない。
function populateIndustrySelect(){
  const sel = document.getElementById('industry');
  const order = ['選択しない', ...Object.keys(INDUSTRY_RAW_DATA.industries)];
  sel.innerHTML = order.map(name=>{
    const b = INDUSTRY_BENCHMARKS[name];
    return `<option value="${escapeHTML(name)}">${escapeHTML(b.label)}</option>`;
  }).join('');
  const note = document.getElementById('industryFieldNote');
  if(note){
    note.textContent = `※業種の選択肢と基準値は、中小企業庁「中小企業実態基本調査」${INDUSTRY_RAW_DATA.dataYear}を基に算出しています（自動更新はせず、年1回手動で更新）。反映指標：売上高営業利益率（経常利益率を近似使用）／労働生産性。自己資本比率・総資産回転率・売上高総利益率・ROA・ROEは全業種共通基準です。`;
  }
}

function initForm(){
  populateIndustrySelect();
  const panelsRoot = document.getElementById('periodPanels');
  [0,1,2].forEach(idx=> panelsRoot.appendChild(buildPeriodPanel(idx)));
  updateTabsVisibility();
  document.getElementById('periodCount').addEventListener('change', updateTabsVisibility);

  document.getElementById('diagnoseBtn').addEventListener('click', runDiagnosis);
  document.getElementById('importRunBtn').addEventListener('click', runImport);
}

function updateTabsVisibility(){
  const count = parseInt(document.getElementById('periodCount').value, 10);
  const labels = {3:['前々期','前期','当期'], 2:[null,'前期','当期'], 1:[null,null,'当期']};
  const tabBar = document.getElementById('tabBar');
  tabBar.innerHTML = '';
  const activeIdxs = [];
  for(let i=0;i<3;i++){
    const lbl = labels[count][i];
    const panel = document.getElementById('panel-'+i);
    if(lbl){
      activeIdxs.push(i);
      const btn = document.createElement('button');
      btn.className = 'tab-btn';
      btn.type = 'button';
      btn.textContent = lbl;
      btn.dataset.idx = i;
      btn.addEventListener('click', ()=> switchTab(i));
      tabBar.appendChild(btn);
      panel.style.display = '';
    } else {
      panel.style.display = 'none';
      panel.classList.remove('active');
    }
  }
  switchTab(activeIdxs[activeIdxs.length-1]);
}
function switchTab(idx){
  [0,1,2].forEach(i=>{
    const panel = document.getElementById('panel-'+i);
    panel.classList.toggle('active', i===idx);
  });
  document.querySelectorAll('.tab-btn').forEach(b=> b.classList.toggle('active', parseInt(b.dataset.idx,10)===idx));
}

function fillPeriod(idx, bs, pl){
  BS_FIELDS.forEach(f=>{ const el=document.getElementById('p'+idx+'_bs_'+f.k); if(el) el.value = bs[f.k]; });
  PL_FIELDS.forEach(f=>{ const el=document.getElementById('p'+idx+'_pl_'+f.k); if(el) el.value = pl[f.k]; });
}
function clearPeriod(idx){
  BS_FIELDS.forEach(f=>{ const el=document.getElementById('p'+idx+'_bs_'+f.k); if(el) el.value=''; });
  PL_FIELDS.forEach(f=>{ const el=document.getElementById('p'+idx+'_pl_'+f.k); if(el) el.value=''; });
}

function readPeriodData(idx){
  const bs = {}; BS_FIELDS.forEach(f=>{ const el=document.getElementById('p'+idx+'_bs_'+f.k); bs[f.k]=parseFloat(el.value)||0; });
  const pl = {}; PL_FIELDS.forEach(f=>{ const el=document.getElementById('p'+idx+'_pl_'+f.k); pl[f.k]=parseFloat(el.value)||0; });
  return {bs, pl};
}

/* ===================== レポート描画 ===================== */
function runDiagnosis(){
  const count = parseInt(document.getElementById('periodCount').value, 10);
  const startIdx = 3 - count;
  const periods = [];
  for(let i=startIdx;i<3;i++) periods.push(readPeriodData(i));
  if(periods[periods.length-1].pl.sales <= 0){
    alert('当期の売上高を入力してください。');
    return;
  }
  const input = {
    companyName: document.getElementById('companyName').value || '（会社名未入力）',
    industry: document.getElementById('industry').value,
    employees: parseFloat(document.getElementById('employees').value) || 0,
    periods,
  };
  const r = diagnose(input);
  const comments = genComments(r);
  renderReport(input, r, comments);
}

function svgWarn(){ return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 9v4M12 17h.01M10.3 3.9L2.6 17.5A1.8 1.8 0 004.2 20h15.6a1.8 1.8 0 001.6-2.5L13.7 3.9a1.8 1.8 0 00-3.4 0z"/></svg>`; }
function svgInfo(){ return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>`; }

function renderReport(input, r, comments){
  document.getElementById('emptyState').style.display = 'none';
  const root = document.getElementById('reportRoot');

  const cats = ['profitability','safety','efficiency','growth','productivity'];
  const earsHTML = cats.map(k=>{
    const score = r.scores[k];
    const na = score===null;
    const h = na ? 4 : Math.max(6, (score/5)*100);
    return `<div class="ear">
      <div class="val">${na?'—':fmt(score)}</div>
      <div class="stalk" style="height:${h}%;background:${na?'#4A5560':CAT_COLOR[k]};"></div>
    </div>`;
  }).join('');
  const earLabelsHTML = cats.map(k=> `<span class="${r.scores[k]===null?'na':''}">${CAT_LABEL[k]}${r.scores[k]===null?'（N/A）':''}</span>`).join('');

  let alerts = '';
  if(r.metrics.balanceSevereIssue){
    alerts += `<div class="alert-line alert-danger">${svgWarn()}<div><b>貸借対照表の差額が大きく（総資産比 約${fmt(r.metrics.gapRatioPct)}%、差額：約${Math.round(r.metrics.balanceGap).toLocaleString()}千円）</b>、この診断結果は信頼できません。総合評価（S〜D）は算出していません。入力値を確認し、再度診断してください。</div></div>`;
  } else if(r.metrics.balanceMinorIssue){
    alerts += `<div class="alert-line alert-warn">${svgWarn()}<div>貸借にわずかな差異があります（総資産比 約${fmt(r.metrics.gapRatioPct)}%、差額：約${Math.round(r.metrics.balanceGap).toLocaleString()}千円）。入力値をご確認ください。以下のスコアは参考値です。</div></div>`;
  }
  if(r.metrics.debtExcess){
    alerts += `<div class="alert-line alert-danger">${svgWarn()}<div>自己資本がマイナス（債務超過）です。ROE等、自己資本を分母とする一部の指標は算出していません。</div></div>`;
  }
  if(r.metrics.specialAlert){
    alerts += `<div class="alert-line alert-warn">${svgWarn()}<div>特別${r.metrics.specialIsGain?'利益':'損失'}が売上高比${fmt(r.metrics.specialRatio)}%と大きく、当期の収益性は参考値です。</div></div>`;
  }
  if(r.metrics.estCF!==null && r.metrics.estCF<0 && r.metrics.netIncome>0){
    alerts += `<div class="alert-line alert-danger">${svgWarn()}<div>黒字ですが、簡易試算では営業キャッシュフローがマイナスの可能性があります（黒字倒産リスクの兆候）。</div></div>`;
  }
  if(r.scores.growth===null && !r.metrics.balanceSevereIssue){
    const reasonText = r.metrics.growthUnavailableReason==='zero-baseline'
      ? '前期実績に0円の項目があり成長率を算出できないため'
      : '1期分のみの入力のため';
    alerts += `<div class="alert-line alert-info">${svgInfo()}<div>${reasonText}、成長性は算出せず、他カテゴリの重みを再配分しています。</div></div>`;
  }

  const legendHTML = SCORE_MEANING.map(m=> `<div class="legend-item"><span class="legend-dot" style="background:${scoreDotColor(m.s)}"></span>${m.s}点：${m.t}</div>`).join('');

  const catCardsHTML = cats.map(k=> catCardHTML(k, r, comments)).join('');

  const assumptions = [
    `業種平均は中小企業庁「中小企業実態基本調査」${INDUSTRY_RAW_DATA.dataYear}の公表データに基づいています（年1回、手動で更新）。業種による補正は現在「売上高営業利益率」（公式統計の売上高経常利益率を近似値として使用）と「労働生産性」の2指標に反映しており、それ以外の指標（自己資本比率・総資産回転率・売上高総利益率・ROA・ROEなど）は産業別の公式データを未取得のため業種共通の基準で採点しています。`,
    '各指標のスコアは、5段階の基準値の間を直線的に補間した連続値（1.0〜5.0）で算出しています。基準値付近でも評価が滑らかに変化するようにするためで、境界のわずかな差で評価が急に1段階変わることを避けています。',
    '簡易資金繰り診断は、キャッシュフロー計算書ではなくB/Sの期間増減から推定した簡易値です。',
    r.n>=2 ? '成長性は2期分以上の決算書がある場合のみ算出します。' : '成長性は2期分以上の決算書がある場合に算出されます（今回は算出していません）。',
    r.metrics.hasEmployees ? '生産性は入力された従業員数をもとに労働生産性で算出しています。' : '生産性は従業員数の入力がないため、総資産あたり付加価値で代替算出しています。',
    '消費税の税込／税抜の違いは自動判定していません。決算書の経理方式に沿って入力してください。',
    '入力された数値はお使いのブラウザ内でのみ処理され、外部のサーバーに送信・保存されることはありません。',
    '本診断は融資審査・与信判断を代替するものではありません。',
  ];

  const badgeBlockHTML = r.badge ? `
        <div class="badge-block">
          <div class="badge" style="color:${BADGE_COLOR[r.badge]}">総合評価　${r.badge}</div>
          <div class="badge-meaning">${BADGE_MEANING[r.badge]}</div>
          <div class="total-score">総合スコア ${fmt(r.total,2)} / 5.0</div>
        </div>` : `
        <div class="badge-block">
          <div class="badge" style="color:#8A8471">総合評価　ー</div>
          <div class="badge-meaning">入力値の確認が必要なため、総合評価は算出していません。上のアラートをご確認ください。</div>
        </div>`;

  root.innerHTML = `
    <div class="report">
      <div class="report-head">
        <div>
          <div class="company">${escapeHTML(input.companyName)}（${input.industry}${input.employees?'・従業員'+input.employees+'名':''}・${r.n}期分で診断）</div>
          <h2>診断レポート</h2>
        </div>
        ${badgeBlockHTML}
      </div>
      <div class="disclaimer-fixed">本診断は融資審査・与信判断を代替するものではありません。参考情報としてご活用ください。</div>

      ${alerts}

      <div class="axis-wrap">
        <div class="ears">${earsHTML}</div>
        <div class="ear-labels">${earLabelsHTML}</div>
      </div>

      <div class="legend-row">${legendHTML}</div>

      <div class="cat-cards">${catCardsHTML}</div>

      <div class="assumption-box">
        <h4>本診断の前提条件</h4>
        <ul>${assumptions.map(a=>`<li>${a}</li>`).join('')}</ul>
      </div>
    </div>
  `;

  document.querySelectorAll('.cat-head').forEach(h=> h.addEventListener('click', ()=>{
    h.closest('.cat-card').classList.toggle('open');
  }));
  // open first card by default
  const first = document.querySelector('.cat-card');
  if(first) first.classList.add('open');
}

function scoreDotColor(s){
  if(s>=5) return '#3F5138'; if(s>=4) return '#5C7452'; if(s>=3) return '#A6763A';
  if(s>=2) return '#B4552B'; return '#9B3B3B';
}
function scorePillColor(s){
  if(s>=4.5) return '#3F5138'; if(s>=3.5) return '#5C7452'; if(s>=2.5) return '#A6763A';
  if(s>=1.5) return '#B4552B'; return '#9B3B3B';
}
function escapeHTML(s){ return s.replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function catCardHTML(k, r, comments){
  const score = r.scores[k];
  const weight = r.weights[k];
  const na = score===null;
  const rows = catMetricRows(k, r);
  const commentHTML = (comments[k]||[]).map(t=>`<p>${t}</p>`).join('');
  return `
  <div class="cat-card">
    <div class="cat-head">
      <div class="cat-head-left">
        <span class="cat-dot" style="background:${CAT_COLOR[k]}"></span>
        <h3>${CAT_LABEL[k]}</h3>
        <span class="cat-weight">重み ${fmt(weight,0)}%</span>
      </div>
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="cat-score">${na?'N/A':fmt(score)}<small> / 5</small></span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
    </div>
    <div class="cat-body">
      <table class="metric-table">
        <thead><tr><th>指標</th><th>実測値</th><th>スコア</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
      <div class="comment-box">${commentHTML}</div>
    </div>
  </div>`;
}

function pill(score){ return `<span class="score-pill" style="background:${scoreDotColor(score)}">${fmt(score)}</span>`; }
// 単位付き数値表示。値がnull（算出不可）の場合は単位を付けず「—」のみを返す（「—%」のような不自然な表示を防ぐ）
function fmtUnit(v, suffix, digits=1){ return v===null||v===undefined||isNaN(v) ? '—' : fmt(v,digits)+suffix; }

function catMetricRows(k, r){
  const m = r.metrics, s = r.sub[k];
  const rowsMap = {
    profitability: [
      ['売上高総利益率', fmtUnit(m.grossMarginPct,'%'), s.gross],
      ['売上高営業利益率', fmtUnit(m.opMarginPct,'%'), s.op],
      ['総資本経常利益率（ROA）', fmtUnit(m.roaPct,'%'), s.roa],
      ['自己資本利益率（ROE）', m.debtExcess?'算出不可（債務超過）':fmtUnit(m.roePct,'%'), s.roe],
    ],
    safety: [
      ['自己資本比率', m.debtExcess?'算出不可（債務超過）':fmtUnit(m.equityRatioPct,'%'), s.equity],
      ['流動比率', m.currentRatioPct===null?'算出不可（流動負債0）':fmtUnit(m.currentRatioPct,'%'), s.current],
      ['当座比率', m.quickRatioPct===null?'算出不可（流動負債0）':fmtUnit(m.quickRatioPct,'%'), s.quick],
      ['固定長期適合率', fmtUnit(m.fixedLTPct,'%'), s.fixedLT],
      ['EBITDA有利子負債倍率', (m.ebitda<=0?'算出不可（EBITDA赤字）':fmtUnit(m.ebitdaDebtX,'倍')), s.ebitdaDebt],
    ],
    efficiency: [
      ['総資産回転率', fmtUnit(m.assetTurnover,'回',2), s.turnover],
      ['CCC（現金化サイクル）', m.cogsZeroNote?'算出不可（売上原価0）':fmtUnit(m.ccc,'日',0), s.ccc],
      ['　内訳：売上債権回転期間', fmtUnit(m.receivableDays,'日',0), null],
      ['　内訳：棚卸資産回転期間', m.cogsZeroNote?'算出不可（売上原価0）':fmtUnit(m.inventoryDays,'日',0), null],
      ['　内訳：仕入債務回転期間', m.cogsZeroNote?'算出不可（売上原価0）':fmtUnit(m.payableDays,'日',0), null],
    ],
    growth: r.scores.growth===null ? [[m.growthUnavailableReason==='zero-baseline'?'算出不可（前期実績0円あり）':'算出不可（1期分のみ）','—',null]] : [
      ['売上高成長率', fmtUnit(m.salesGrowthPct,'%'), s.sales],
      ['経常利益成長率', fmtUnit(m.profitGrowthPct,'%'), s.profit],
      ['総資産成長率', fmtUnit(m.assetGrowthPct,'%'), s.asset],
    ],
    productivity: m.hasEmployees ? [
      ['労働生産性（付加価値／従業員数）', fmtUnit(m.laborProductivity,'万円',0), s.labor],
      ['労働分配率（参考・非スコア）', fmtUnit(m.laborShare,'%'), null],
    ] : [
      ['総資産あたり付加価値（代替指標）', fmtUnit(m.valueAddedOverAssets,'%'), s.asset],
    ],
  };
  return rowsMap[k].map(row=>{
    const [name, val, sc] = row;
    return `<tr><td>${name}</td><td class="num">${val}</td><td class="num">${sc!==null?pill(sc):'—'}</td></tr>`;
  }).join('');
}

/* ===================== 決算書ファイル取込 ===================== */
// フィールドごとの検索キーワード。mode:'set'＝この行だけで確定、'add'＝複数行を合算
const IMPORT_ALIASES = [
  // --- B/S ---
  {field:'cash', mode:'set', words:['現金及び預金','現金預金','現金及び現金同等物','現金・預金']},
  {field:'receivable', mode:'set', words:['受取手形及び売掛金','売掛金及び受取手形','売上債権','受取手形・売掛金']},
  {field:'receivable', mode:'add', words:['電子記録債権','受取手形','売掛金']},
  {field:'inventory', mode:'set', words:['棚卸資産']},
  {field:'inventory', mode:'add', words:['商品及び製品','商品','製品','仕掛品','原材料及び貯蔵品','原材料','貯蔵品']},
  {field:'otherCA', mode:'set', words:['その他流動資産','流動資産その他']},
  {field:'tangible', mode:'set', words:['有形固定資産合計','有形固定資産計','有形固定資産']},
  {field:'intangible', mode:'set', words:['無形固定資産合計','無形固定資産計','無形固定資産']},
  {field:'investments', mode:'set', words:['投資その他の資産合計','投資その他の資産計','投資その他の資産','投資その他資産']},
  {field:'currentLiab', mode:'set', words:['流動負債合計','流動負債']},
  {field:'payable', mode:'set', words:['支払手形及び買掛金','買掛金及び支払手形','仕入債務']},
  {field:'payable', mode:'add', words:['電子記録債務','支払手形','買掛金']},
  {field:'fixedLiab', mode:'set', words:['固定負債合計','固定負債']},
  {field:'equity', mode:'set', words:['純資産合計','純資産の部合計','資本合計','株主資本合計']},
  {field:'interestDebt', mode:'add', words:['1年以内返済予定の長期借入金','短期借入金','長期借入金','社債']},
  // --- P/L ---
  {field:'sales', mode:'set', words:['売上高合計','売上高','営業収益']},
  {field:'cogs', mode:'set', words:['売上原価']},
  {field:'labor', mode:'add', words:['給料手当','給料及び手当','役員報酬','法定福利費','賞与','人件費']},
  {field:'rent', mode:'set', words:['地代家賃','賃借料']},
  {field:'dep', mode:'set', words:['減価償却費']},
  {field:'tax', mode:'set', words:['租税公課']},
  {field:'sgaTotal', mode:'set', words:['販売費及び一般管理費合計','販売費及び一般管理費']},
  {field:'nonOpInc', mode:'set', words:['営業外収益']},
  {field:'nonOpExp', mode:'set', words:['営業外費用']},
  {field:'exGain', mode:'set', words:['特別利益']},
  {field:'exLoss', mode:'set', words:['特別損失']},
  {field:'corpTax', mode:'set', words:['法人税、住民税及び事業税','法人税及び住民税','法人税等']},
  // 「負債及び純資産合計」等は「純資産合計」を部分文字列として含むため誤検出しやすい。
  // 他のどのフィールドとしても扱わないよう、明示的に除外する。
  {field:null, mode:'skip', words:['負債及び純資産合計','負債・純資産合計','負債純資産合計','負債及び資本合計']},
].flatMap(e=> e.words.map(w=>({field:e.field, mode:e.mode, word:w})))
 .sort((a,b)=> b.word.length - a.word.length); // 長い語句（より具体的な語）を優先的に照合

const IMPORT_FIELD_LABEL = (()=>{
  const m = {};
  BS_FIELDS.forEach(f=> m[f.k]=f.l);
  PL_FIELDS.forEach(f=> m[f.k]=f.l);
  return m;
})();

function normalizeNumToken(tok){
  if(tok==null) return null;
  let s = String(tok).trim();
  if(s==='') return null;
  // 全角数字・記号を半角へ
  s = s.replace(/[０-９]/g, c=> String.fromCharCode(c.charCodeAt(0)-0xFEE0));
  let neg = false;
  if(/^[△▲]/.test(s)){ neg = true; s = s.replace(/^[△▲]/,''); }
  if(/^\(.*\)$/.test(s)){ neg = true; s = s.replace(/^\(|\)$/g,''); }
  if(/^-/.test(s)){ neg = true; s = s.replace(/^-/,''); }
  s = s.replace(/[,，]/g,'').replace(/円|千円/g,'').trim();
  if(!/^\d+(\.\d+)?$/.test(s)) return null;
  const v = parseFloat(s);
  if(isNaN(v)) return null;
  return neg ? -v : v;
}

// 行頭の項番・記号（Ⅰ Ⅱ…、①②…、(1) 1.、【 】など）を除去してから照合する
function cleanLabel(label){
  return label
    .replace(/^[\s　]*[ⅠⅡⅢⅣⅤⅥⅦⅧⅨⅩ]{1,3}[\.\s　]*/,'')
    .replace(/^[\s　]*[①②③④⑤⑥⑦⑧⑨⑩]/,'')
    .replace(/^[\s　]*\(?[0-9]{1,2}\)?[\.\s　、]+/,'')
    .replace(/^[\s　]*【/,'')
    .replace(/】[\s　]*$/,'')
    .trim();
}

// 1行分のテキストから、ラベルと数値列を抽出
function matchLine(rawLabel, numbers){
  if(!rawLabel || numbers.length===0) return null;
  const label = cleanLabel(rawLabel);
  // まず「行頭が科目名と一致する」ものを優先（複数行が混ざった場合の誤認識を防ぐ）
  for(const entry of IMPORT_ALIASES){
    if(label.startsWith(entry.word)){
      if(entry.mode==='skip') return null; // 「負債及び純資産合計」等、他科目名を含む合計行は無視
      return {field:entry.field, mode:entry.mode, numbers};
    }
  }
  // 見つからなければ、行のどこかに科目名が含まれるかで判定
  for(const entry of IMPORT_ALIASES){
    if(label.includes(entry.word)){
      if(entry.mode==='skip') return null;
      return {field:entry.field, mode:entry.mode, numbers};
    }
  }
  return null;
}

// 抽出した「フィールド→数値配列」を、期数分の列にそろえる（右寄せが既定＝右端が最新期）
function buildPeriodColumns(fieldArrays, alignRight){
  let columnCount = 0;
  const counts = {};
  Object.values(fieldArrays).forEach(arr=>{ if(arr && arr.length){ counts[arr.length]=(counts[arr.length]||0)+1; } });
  Object.keys(counts).forEach(len=>{ if(counts[len] > (counts[columnCount]||0)) columnCount = parseInt(len,10); });
  if(columnCount===0) columnCount = 1;

  const aligned = {};
  Object.keys(fieldArrays).forEach(key=>{
    const arr = fieldArrays[key] || [];
    const out = new Array(columnCount).fill(null);
    const offset = alignRight ? (columnCount - arr.length) : 0;
    arr.forEach((v,i)=>{ const idx = offset+i; if(idx>=0 && idx<columnCount) out[idx]=v; });
    aligned[key] = out;
  });
  return {columnCount, aligned};
}

function collectRowsFromExcelSheet(sheet){
  const rows = XLSX.utils.sheet_to_json(sheet, {header:1, raw:true, defval:''});
  const out = [];
  rows.forEach(row=>{
    let labelIdx = -1;
    for(let i=0;i<row.length;i++){
      if(typeof row[i]==='string' && row[i].trim()!=='' && normalizeNumToken(row[i])===null){ labelIdx = i; break; }
    }
    if(labelIdx===-1) return;
    const label = String(row[labelIdx]).trim();
    const numbers = [];
    for(let i=labelIdx+1;i<row.length;i++){
      const v = normalizeNumToken(row[i]);
      if(v!==null) numbers.push(v);
    }
    if(numbers.length>0) out.push({label, numbers});
  });
  return out;
}

function collectRowsFromPdfLines(lines){
  const numRe = /[△▲-]?\(?[0-9０-９][0-9０-９,，]*\)?/g;
  const out = [];
  lines.forEach(line=>{
    const matches = line.match(numRe);
    if(!matches || matches.length===0) return;
    const numbers = matches.map(normalizeNumToken).filter(v=> v!==null);
    if(numbers.length===0) return;
    const label = line.replace(numRe,' ').trim();
    if(label==='') return;
    out.push({label, numbers});
  });
  return out;
}

// 1ファイル分の行データ（label + numbers[]）から、期ごとのB/S・P/L値を組み立てる
function rowsToPeriodColumns(rows, alignRight){
  const fieldArrays = {}; // field -> number[]（列位置つき、set優先・addは合算）
  const setDone = {};
  rows.forEach(r=>{
    const m = matchLine(r.label, r.numbers);
    if(!m) return;
    if(m.mode==='set'){
      fieldArrays[m.field] = m.numbers.slice();
      setDone[m.field] = true;
    } else if(m.mode==='add'){
      if(setDone[m.field]) return;
      if(!fieldArrays[m.field]) fieldArrays[m.field] = m.numbers.slice();
      else {
        const cur = fieldArrays[m.field];
        const len = Math.max(cur.length, m.numbers.length);
        const merged = new Array(len).fill(0);
        for(let i=0;i<len;i++) merged[i] = (cur[i]||0) + (m.numbers[i]||0);
        fieldArrays[m.field] = merged;
      }
    }
  });

  const {columnCount, aligned} = buildPeriodColumns(fieldArrays, alignRight);
  const matchedFields = Object.keys(fieldArrays);

  const periods = [];
  for(let c=0;c<columnCount;c++){
    const bs = {}; BS_FIELDS.forEach(f=> bs[f.k] = aligned[f.k] ? (aligned[f.k][c]||0) : 0);
    const pl = {}; PL_FIELDS.forEach(f=> pl[f.k] = aligned[f.k] ? (aligned[f.k][c]||0) : 0);
    // 販管費合計の内訳が個別に取れなかった場合、合計から既知項目を引いて「その他販管費」に充当
    if(aligned.sgaTotal){
      const total = aligned.sgaTotal[c] || 0;
      const known = pl.labor + pl.rent + pl.dep + pl.tax;
      pl.sgaOther = Math.max(0, total - known);
    }
    periods.push({bs, pl});
  }
  return {periods, matchedFields};
}

function applyUnit(periods, unitFactor){
  // アプリ内部は千円単位。unitFactorは「1円あたり何千円か」ではなく円換算係数（1/1000/1000000）
  const mul = unitFactor/1000;
  periods.forEach(pr=>{
    BS_FIELDS.forEach(f=> pr.bs[f.k] = Math.round(pr.bs[f.k]*mul));
    PL_FIELDS.forEach(f=> pr.pl[f.k] = Math.round(pr.pl[f.k]*mul));
  });
}

async function readExcelLikeFile(file){
  const isCsv = /\.csv$/i.test(file.name);
  let workbook;
  if(isCsv){
    const text = await file.text();
    workbook = XLSX.read(text, {type:'string'});
  } else {
    const buf = await file.arrayBuffer();
    workbook = XLSX.read(buf, {type:'array'});
  }
  let rows = [];
  workbook.SheetNames.forEach(name=>{
    rows = rows.concat(collectRowsFromExcelSheet(workbook.Sheets[name]));
  });
  return rows;
}

async function readPdfFile(file){
  if(typeof pdfjsLib==='undefined'){
    throw new Error('PDF読み込みライブラリが利用できません（ネットワーク接続をご確認ください）。');
  }
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  const buf = await file.arrayBuffer();
  const doc = await pdfjsLib.getDocument({data:buf}).promise;
  const lines = [];
  // 決算書PDFは、同じ行に見えても「数字」と「日本語ラベル」でフォントが異なり、
  // Y座標（ベースライン位置）が数ポイント程度ズレていることが多い。
  // 単純な丸め一致ではなく、許容誤差つきでクラスタリングして「同じ行」を判定する。
  const Y_TOL = 3.0;
  for(let p=1;p<=doc.numPages;p++){
    const page = await doc.getPage(p);
    const content = await page.getTextContent();
    const items = content.items
      .filter(it=> it.str && it.str.trim()!=='')
      .map(it=>({str:it.str, x:it.transform[4], y:it.transform[5], w:(it.width||it.str.length*(it.height||8)*0.55)}));

    const rows = [];
    items.sort((a,b)=> b.y-a.y).forEach(it=>{
      let row = rows.find(r=> Math.abs(r.y-it.y) <= Y_TOL);
      if(!row){ row = {y:it.y, items:[]}; rows.push(row); }
      row.items.push(it);
      row.y = (row.y*(row.items.length-1)+it.y)/row.items.length; // クラスタ重心を更新
    });
    rows.sort((a,b)=> b.y-a.y);

    rows.forEach(row=>{
      const its = row.items.slice().sort((a,b)=> a.x-b.x);
      let line = '';
      let prevEnd = null;
      its.forEach(it=>{
        if(prevEnd!==null && (it.x-prevEnd) > 1.5) line += ' '; // 列間の大きな間隔にのみ空白を挿入
        line += it.str;
        prevEnd = it.x + it.w;
      });
      lines.push(line);
    });
  }
  const rows = collectRowsFromPdfLines(lines);
  if(rows.length===0){
    // テキストが1文字も取れない＝スキャン画像PDF（OCR未対応）である可能性が高い
    throw new Error('文字情報を抽出できませんでした。スキャン画像のPDF（テキスト選択できないPDF）は非対応です。お手数ですが該当ページを手入力してください。');
  }
  return rows;
}

async function runImport(){
  const fileInput = document.getElementById('importFileInput');
  const statusEl = document.getElementById('importStatus');
  const files = Array.from(fileInput.files || []);
  if(files.length===0){
    statusEl.innerHTML = '<span class="warn">ファイルが選択されていません。</span>';
    return;
  }
  const unitFactor = parseFloat(document.getElementById('importUnit').value);
  const alignRight = true; // 列数が期数より少ない場合は右（＝新しい期側）に寄せて補完する
  const newLeft = document.getElementById('importOrder').value === 'new-left';

  const btn = document.getElementById('importRunBtn');
  btn.disabled = true;
  btn.textContent = '読み込み中…';
  statusEl.textContent = '';

  let allPeriods = [];
  const allMatchedFields = new Set();
  const fileLogs = [];

  for(const file of files){
    try{
      let rows;
      if(/\.pdf$/i.test(file.name)) rows = await readPdfFile(file);
      else rows = await readExcelLikeFile(file);

      const {periods, matchedFields} = rowsToPeriodColumns(rows, alignRight);
      if(matchedFields.size===0){
        // 行は読めたが、既知の科目名に1件も一致しなかった＝様式が想定と異なる可能性が高い。
        // 空の期をそのまま追加すると「0円の期」が紛れ込んで診断結果を歪めるため、ここで打ち切る。
        fileLogs.push(`「${file.name}」：数値は検出できましたが、既知の科目名と一致しませんでした（様式が対応外の可能性）。手入力をお願いします。`);
        continue;
      }
      matchedFields.forEach(f=> allMatchedFields.add(f));
      applyUnit(periods, unitFactor);
      const ordered = newLeft ? periods.slice().reverse() : periods;
      allPeriods = allPeriods.concat(ordered);
      fileLogs.push(`「${file.name}」：${periods.length}期分を検出`);
    } catch(err){
      fileLogs.push(`「${file.name}」：読み込みに失敗しました（${err.message||err}）`);
    }
  }

  btn.disabled = false;
  btn.textContent = '読み込んでフォームに反映';

  if(allPeriods.length===0){
    statusEl.innerHTML = `<span class="warn">数値を認識できませんでした。</span><ul>${fileLogs.map(l=>`<li>${l}</li>`).join('')}</ul>`;
    return;
  }

  // 直近3期分のみ採用
  if(allPeriods.length>3) allPeriods = allPeriods.slice(allPeriods.length-3);
  const count = allPeriods.length;

  // 期またぎで売上高の桁が極端に違う場合、単位設定のミスや列のズレの可能性が高いため警告する
  let magnitudeWarning = null;
  const salesValues = allPeriods.map(p=>p.pl.sales).filter(v=> v>0);
  if(salesValues.length>=2){
    const maxV = Math.max(...salesValues), minV = Math.min(...salesValues);
    if(maxV / minV > 20){
      magnitudeWarning = `期による売上高の差が${Math.round(maxV/minV)}倍と極端です。単位設定（円／千円／百万円）や、期の並び順の取り違えがないかご確認ください。`;
    }
  }

  document.getElementById('periodCount').value = String(count);
  updateTabsVisibility();
  [0,1,2].forEach(i=>clearPeriod(i));
  const startIdx = 3 - count;
  allPeriods.forEach((pr,i)=> fillPeriod(startIdx+i, pr.bs, pr.pl));

  if(!document.getElementById('companyName').value){
    const first = files[0].name.replace(/\.(pdf|xlsx|xls|csv)$/i,'');
    document.getElementById('companyName').value = first;
  }

  const allKeys = [...BS_FIELDS.map(f=>f.k), ...PL_FIELDS.map(f=>f.k)];
  const unmatched = allKeys.filter(k=> !allMatchedFields.has(k) && k!=='sgaOther');
  const unmatchedLabels = unmatched.map(k=> IMPORT_FIELD_LABEL[k]);

  let html = `<span class="ok">${count}期分をフォームに反映しました。</span><ul>${fileLogs.map(l=>`<li>${l}</li>`).join('')}</ul>`;
  html += '<div>反映後の数値は自動抽出の下書きです。各期タブの内容を必ずご確認ください。</div>';
  if(magnitudeWarning){
    html += `<div style="margin-top:6px;" class="warn">⚠ ${magnitudeWarning}</div>`;
  }
  if(unmatchedLabels.length>0){
    html += `<div style="margin-top:6px;" class="warn">自動認識できなかった項目（0円のまま。手入力してください）：</div><ul>${unmatchedLabels.map(l=>`<li>${l}</li>`).join('')}</ul>`;
  }
  statusEl.innerHTML = html;
}

initForm();
</script>
