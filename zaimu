};
const SCORE_MEANING = [
  {s:5, t:'業種内でも上位の水準'}, {s:4, t:'平均を上回る良好な水準'}, {s:3, t:'標準的な水準'},
  {s:2, t:'平均をやや下回る。改善余地あり'}, {s:1, t:'早めに対策を検討したい水準'},
];

const BS_FIELDS = [
  {k:'cash', l:'現金及び預金'}, {k:'receivable', l:'売上債権（受取手形＋売掛金）'},
  {k:'inventory', l:'棚卸資産'}, {k:'otherCA', l:'その他流動資産'},
  {k:'tangible', l:'有形固定資産'}, {k:'intangible', l:'無形固定資産'}, {k:'investments', l:'投資その他の資産'},
  {k:'currentLiab', l:'流動負債合計'}, {k:'payable', l:'うち仕入債務（支払手形＋買掛金）', sub:true},
  {k:'fixedLiab', l:'固定負債合計'},
  {k:'equity', l:'純資産合計'}, {k:'interestDebt', l:'うち有利子負債（短期・長期借入金＋社債）', sub:true},
];
const PL_FIELDS = [
  {k:'sales', l:'売上高'}, {k:'cogs', l:'売上原価'},
  {k:'labor', l:'人件費'}, {k:'rent', l:'賃借料'}, {k:'dep', l:'減価償却費'}, {k:'tax', l:'租税公課'}, {k:'sgaOther', l:'その他販管費'},
  {k:'nonOpInc', l:'営業外収益'}, {k:'nonOpExp', l:'営業外費用'},
  {k:'exGain', l:'特別利益'}, {k:'exLoss', l:'特別損失'}, {k:'corpTax', l:'法人税等'},
];

/* ===================== 計算エンジン ===================== */
function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }
// c = [値が良いほど有利な基準を、5点/4点/3点/2点の順の閾値4つ] で受け取る。
// 境界で1点飛びに変化する「崖」を避けるため、閾値の間は線形補間して連続値（1.0〜5.0）を返す。
// 境界ちょうどの値では従来の段階方式と同じ点数になるよう設計している。
function scoreHigher(v, c){
  if(v===null || v===undefined || !isFinite(v)) return null;
  const [c5,c4,c3,c2] = c;
  if(v>=c5) return 5;
  if(v>=c4) return clamp(4 + (v-c4)/(c5-c4), 1, 5);
  if(v>=c3) return clamp(3 + (v-c3)/(c4-c3), 1, 5);
  if(v>=c2) return clamp(2 + (v-c2)/(c3-c2), 1, 5);
  const c1 = c2 - (c3-c2); // 2点帯と同じ幅を1点側にも仮想的に延長
  return clamp(1 + (v-c1)/(c2-c1), 1, 5);
}
function scoreLower(v, c){
  if(v===null || v===undefined || !isFinite(v)) return null;
  const [c5,c4,c3,c2] = c;
  if(v<=c5) return 5;
  if(v<=c4) return clamp(5 - (v-c5)/(c4-c5), 1, 5);
  if(v<=c3) return clamp(4 - (v-c4)/(c3-c4), 1, 5);
  if(v<=c2) return clamp(3 - (v-c3)/(c2-c3), 1, 5);
  const c1 = c2 + (c2-c3);
  return clamp(2 - (v-c2)/(c1-c2), 1, 5);
}
// nullを無視した平均。全てnullならnullを返す（=そのカテゴリは算出不可として重み再配分に回す）
function avgDefined(arr){
  const xs = arr.filter(x=> x!==null && x!==undefined && !isNaN(x));
  if(xs.length===0) return null;
  return xs.reduce((a,b)=>a+b,0)/xs.length;
}
function safeDiv(num, den){
  if(den===null || den===undefined || !isFinite(den) || den===0) return null;
  const v = num/den;
  return isFinite(v) ? v : null;
}

function derivePL(p){
  const gross = p.sales - p.cogs;
  const sgaTotal = p.labor + p.rent + p.dep + p.tax + p.sgaOther;
  const opProfit = gross - sgaTotal;
  const ordinary = opProfit + p.nonOpInc - p.nonOpExp;
  const pretax = ordinary + p.exGain - p.exLoss;
  const netIncome = pretax - p.corpTax;
  const addedValue = opProfit + p.labor + p.rent + p.dep + p.tax;
  const ebitda = opProfit + p.dep;
  return {gross, sgaTotal, opProfit, ordinary, pretax, netIncome, addedValue, ebitda};
}
function deriveBS(b){
  const currentAssets = b.cash + b.receivable + b.inventory + b.otherCA;
  const fixedAssets = b.tangible + b.intangible + b.investments;
  const totalAssets = currentAssets + fixedAssets;
  const totalLiab = b.currentLiab + b.fixedLiab;
  const balanceGap = totalAssets - (totalLiab + b.equity);
  return {currentAssets, fixedAssets, totalAssets, currentLiab:b.currentLiab, fixedLiab:b.fixedLiab, totalLiab,
    equity:b.equity, balanceGap, interestDebt:b.interestDebt, inventory:b.inventory, receivable:b.receivable, payable:b.payable};
}

function diagnose(input){
  const n = input.periods.length;
  const derived = input.periods.map(pr=>({bs:deriveBS(pr.bs), pl:derivePL(pr.pl)}));
  const cur = derived[n-1];
  const prevD = n>=2 ? derived[n-2] : null;
  const prev2D = n>=3 ? derived[n-3] : null;
  const latestRaw = input.periods[n-1];
  const avg = (a,b)=> (b!=null) ? (a+b)/2 : a;
  const bench = INDUSTRY_BENCHMARKS[input.industry] || INDUSTRY_BENCHMARKS["選択しない"];

  // 貸借対照表の整合性チェック（この後の全計算に影響するため最初に評価する）
  const gapRatioPct = Math.abs(cur.bs.balanceGap) / Math.max(1, cur.bs.totalAssets) * 100;
  const balanceMinorIssue = gapRatioPct > 2;   // 軽微なズレ：警告を出しつつ計算は続行
  const balanceSevereIssue = gapRatioPct > 5;  // 大きなズレ：総合評価バッジは算出しない

  // 自己資本がゼロ以下＝債務超過。ROE等が分母マイナスで見かけ上プラスになる罠を避けるため別扱いにする。
  const debtExcess = cur.bs.equity <= 0;

  // 収益性
  const grossMarginPct = safeDiv(cur.pl.gross, latestRaw.pl.sales)!==null ? cur.pl.gross/latestRaw.pl.sales*100 : null;
  const opMarginPct = safeDiv(cur.pl.opProfit, latestRaw.pl.sales)!==null ? cur.pl.opProfit/latestRaw.pl.sales*100 : null;
  const avgAssets = avg(cur.bs.totalAssets, prevD?prevD.bs.totalAssets:null);
  const roaPct = avgAssets>0 ? cur.pl.ordinary/avgAssets*100 : null;
  const avgEquity = avg(cur.bs.equity, prevD?prevD.bs.equity:null);
  const roePct = (!debtExcess && avgEquity>0) ? cur.pl.netIncome/avgEquity*100 : null;
  // 売上高総利益率は、産業大分類別の公式集計を安全に取得できていないため全業種共通基準を使用
  const sGross = scoreHigher(grossMarginPct, BANDS.gross);
  // 売上高営業利益率は、中小企業実態基本調査の「売上高経常利益率」（業種別）を近似値として基準を補正
  const opCuts = BANDS.op.map(c=>c*bench.opMarginRatio);
  const sOp = scoreHigher(opMarginPct, opCuts);
  const sRoa = scoreHigher(roaPct, BANDS.roa);
  const sRoe = debtExcess ? 1 : scoreHigher(roePct, BANDS.roe); // 債務超過は自動的に最低評価とする
  const profitabilityScore = avgDefined([sGross,sOp,sRoa,sRoe]);
  const specialRatio = latestRaw.pl.sales>0 ? Math.abs(latestRaw.pl.exGain-latestRaw.pl.exLoss)/latestRaw.pl.sales*100 : 0;
  const specialAlert = specialRatio > 5;
  const specialIsGain = latestRaw.pl.exGain >= latestRaw.pl.exLoss;

  // 安全性
  const equityRatioPct = cur.bs.totalAssets>0 ? cur.bs.equity/cur.bs.totalAssets*100 : null;
  const currentRatioPct = cur.bs.currentLiab>0 ? cur.bs.currentAssets/cur.bs.currentLiab*100 : null;
  const quickAssets = cur.bs.currentAssets - cur.bs.inventory;
  const quickRatioPct = cur.bs.currentLiab>0 ? quickAssets/cur.bs.currentLiab*100 : null;
  const fixedLTDenom = cur.bs.equity + cur.bs.fixedLiab;
  const fixedLTPct = fixedLTDenom>0 ? cur.bs.fixedAssets/fixedLTDenom*100 : null;
  const ebitdaDebtX = cur.pl.ebitda>0 ? cur.bs.interestDebt/cur.pl.ebitda : null;
  const sEquity = debtExcess ? 1 : scoreHigher(equityRatioPct, BANDS.equity);
  const sCurrent = scoreHigher(currentRatioPct, BANDS.current);
  const sQuick = scoreHigher(quickRatioPct, BANDS.quick);
  const sFixedLT = scoreLower(fixedLTPct, BANDS.fixedLT);
  const sEbitdaDebt = cur.pl.ebitda<=0 ? 1 : scoreLower(ebitdaDebtX, BANDS.ebitdaDebt);
  const safetyScore = avgDefined([sEquity,sCurrent,sQuick,sFixedLT,sEbitdaDebt]);
  const lowEquityWarning = !debtExcess && equityRatioPct!==null && equityRatioPct < 15;

  let estCF = null;
  if(prevD){
    const dReceivable = cur.bs.receivable - prevD.bs.receivable;
    const dInventory = cur.bs.inventory - prevD.bs.inventory;
    const dPayable = cur.bs.payable - prevD.bs.payable;
    estCF = cur.pl.netIncome + cur.pl.dep - dReceivable - dInventory + dPayable;
  }

  // 効率性
  const assetTurnover = avgAssets>0 ? latestRaw.pl.sales/avgAssets : null;
  const receivableDays = latestRaw.pl.sales>0 ? cur.bs.receivable/latestRaw.pl.sales*365 : null;
  const inventoryDays = latestRaw.pl.cogs>0 ? cur.bs.inventory/latestRaw.pl.cogs*365 : null;
  const payableDays = latestRaw.pl.cogs>0 ? cur.bs.payable/latestRaw.pl.cogs*365 : null;
  const ccc = (receivableDays!==null && inventoryDays!==null && payableDays!==null) ? receivableDays+inventoryDays-payableDays : null;
  // 総資産回転率は、産業大分類別の公式集計を安全に取得できていないため全業種共通基準を使用
  const sTurnover = scoreHigher(assetTurnover, BANDS.turnover);
  const sCcc = scoreLower(ccc, BANDS.ccc);
  const efficiencyScore = avgDefined([sTurnover,sCcc]);
  const cogsZeroNote = latestRaw.pl.cogs<=0; // 売上原価が0（サービス業などで未入力/該当なし）だとCCC関連が算出不可になる

  // 成長性
  let growthScore=null, salesGrowthPct=null, profitGrowthPct=null, assetGrowthPct=null, growthTrendNote=null;
  let sSales=null,sProfit=null,sAsset=null;
  let growthUnavailableReason = n<2 ? 'insufficient-periods' : null;
  if(n>=2){
    const prevSales = input.periods[n-2].pl.sales;
    salesGrowthPct = prevSales>0 ? (latestRaw.pl.sales-prevSales)/prevSales*100 : null;
    profitGrowthPct = prevD.pl.ordinary!==0 ? (cur.pl.ordinary-prevD.pl.ordinary)/Math.abs(prevD.pl.ordinary)*100 : null;
    assetGrowthPct = prevD.bs.totalAssets>0 ? (cur.bs.totalAssets-prevD.bs.totalAssets)/prevD.bs.totalAssets*100 : null;
    sSales = scoreHigher(salesGrowthPct, BANDS.growth);
    sProfit = scoreHigher(profitGrowthPct, BANDS.growth);
    sAsset = scoreHigher(assetGrowthPct, BANDS.growth);
    growthScore = avgDefined([sSales,sProfit,sAsset]);
    if(growthScore===null) growthUnavailableReason = 'zero-baseline'; // 前期実績が0円などで比率計算そのものができないケース
    if(n>=3 && input.periods[n-3].pl.sales>0 && salesGrowthPct!==null){
      const prevGrowthPct = (input.periods[n-2].pl.sales - input.periods[n-3].pl.sales)/input.periods[n-3].pl.sales*100;
      const diff = salesGrowthPct - prevGrowthPct;
      if(diff > 8) growthTrendNote = 'up-spike';
      else if(diff < -8) growthTrendNote = 'slowdown';
    }
  }

  // 生産性
  const hasEmployees = input.employees && input.employees>0;
  let productivityScore, laborProductivity=null, valueAddedOverAssets=null, laborShare=null;
  if(hasEmployees){
    laborProductivity = cur.pl.addedValue / input.employees / 10;
    laborShare = cur.pl.addedValue>0 ? latestRaw.pl.labor/cur.pl.addedValue*100 : null;
    // 労働生産性は、中小企業実態基本調査の「従業者1人当たり付加価値額」（業種別）で基準を補正
    const prodHeadCuts = BANDS.prodHead.map(c=>c*bench.prodRatio);
    productivityScore = scoreHigher(laborProductivity, prodHeadCuts);
  } else {
    valueAddedOverAssets = cur.bs.totalAssets>0 ? cur.pl.addedValue/cur.bs.totalAssets*100 : null;
    productivityScore = scoreHigher(valueAddedOverAssets, BANDS.prodAsset);
  }

  // 重み：カテゴリのスコアが算出不可（null）の場合、そのカテゴリの重みを算出可能な他カテゴリへ比例配分する。
  // （旧版は「成長性が1期分のみで算出不可」の場合のみ特別扱いしていたが、
  // 　ゼロ除算等により他カテゴリが算出不可になるケースも同じ仕組みで扱えるよう一般化した）
  const baseWeights = {profitability:20, safety:25, efficiency:20, growth:20, productivity:15};
  const scoresByCat = {profitability:profitabilityScore, safety:safetyScore, efficiency:efficiencyScore, growth:growthScore, productivity:productivityScore};
  const catKeys = Object.keys(baseWeights);
  let weights = {...baseWeights};
  const undefinedCats = catKeys.filter(k=> scoresByCat[k]===null);
  if(undefinedCats.length>0){
    const undefinedWeightSum = undefinedCats.reduce((s,k)=>s+weights[k],0);
    const definedCats = catKeys.filter(k=> !undefinedCats.includes(k));
    const definedWeightSum = definedCats.reduce((s,k)=>s+weights[k],0);
    if(definedWeightSum>0){
      definedCats.forEach(k=> weights[k] = weights[k] + undefinedWeightSum*(weights[k]/definedWeightSum));
    }
    undefinedCats.forEach(k=> weights[k]=0);
  }

  const total = catKeys.reduce((sum,k)=> sum + (scoresByCat[k]||0)*weights[k], 0) / 100;
  const totalAvailable = definedCatCount(scoresByCat) > 0;

  let badge;
  if(!totalAvailable || balanceSevereIssue){
    badge = null; // 主要指標が算出不可、または貸借不一致が大きい場合はS〜Dの断定評価を出さない
  } else if(total>=4.5) badge='S'; else if(total>=3.8) badge='A'; else if(total>=3.0) badge='B+';
  else if(total>=2.3) badge='B'; else if(total>=1.5) badge='C'; else badge='D';

  return {
    n, badge, total:(badge?total:null), weights,
    scores:{profitability:profitabilityScore, safety:safetyScore, efficiency:efficiencyScore, growth:growthScore, productivity:productivityScore},
    sub:{
      profitability:{gross:sGross, op:sOp, roa:sRoa, roe:sRoe},
      safety:{equity:sEquity, current:sCurrent, quick:sQuick, fixedLT:sFixedLT, ebitdaDebt:sEbitdaDebt},
      efficiency:{turnover:sTurnover, ccc:sCcc},
      growth: growthScore!==null ? {sales:sSales, profit:sProfit, asset:sAsset} : null,
      productivity: hasEmployees ? {labor:productivityScore} : {asset:productivityScore},
    },
    metrics:{grossMarginPct,opMarginPct,roaPct,roePct,equityRatioPct,currentRatioPct,quickRatioPct,fixedLTPct,ebitdaDebtX,ebitda:cur.pl.ebitda,
      assetTurnover,ccc,receivableDays,inventoryDays,payableDays,salesGrowthPct,profitGrowthPct,assetGrowthPct,growthTrendNote,growthUnavailableReason,
      laborProductivity,valueAddedOverAssets,laborShare,hasEmployees,cogsZeroNote,
      specialRatio,specialAlert,specialIsGain,estCF,balanceGap:cur.bs.balanceGap,gapRatioPct,balanceMinorIssue,balanceSevereIssue,lowEquityWarning,debtExcess,
      netIncome:cur.pl.netIncome, totalAssets:cur.bs.totalAssets, opProfit:cur.pl.opProfit,
    }
  };
}
function definedCatCount(scoresByCat){ return Object.values(scoresByCat).filter(v=> v!==null).length; }

/* ===================== コメント生成 ===================== */
function fmt(v, digits=1){ if(v===null||v===undefined||isNaN(v)) return '—'; return v.toFixed(digits); }

// null（算出不可）を「悪い」と誤判定しないための比較ヘルパー
function ge(v,n){ return v!==null && v!==undefined && v>=n; }
function le(v,n){ return v!==null && v!==undefined && v<=n; }

function genComments(r){
  const m = r.metrics, s = r.sub;
  const c = {};

  if(m.balanceSevereIssue){
    // 貸借差異が大きい場合は、個別カテゴリのコメントより先にこれを伝える
    return {
      profitability:['貸借対照表の差異が大きいため、この診断結果は参考にできません。まず入力値をご確認ください。'],
      safety:['同上のため、安全性の評価も保留しています。'],
      efficiency:['同上のため、効率性の評価も保留しています。'],
      growth:['同上のため、成長性の評価も保留しています。'],
      productivity:['同上のため、生産性の評価も保留しています。'],
    };
  }

  // 収益性
  c.profitability = [];
  if(m.specialAlert){
    c.profitability.push(`特別${m.specialIsGain?'利益':'損失'}が売上高比${fmt(m.specialRatio)}%と大きく、当期の収益性は参考値です。経常利益ベースの本業の実力を中心にご覧ください。`);
  }
  if(ge(s.profitability.op,4) && ge(s.profitability.roa,4)){
    c.profitability.push('本業でしっかり稼げており、資産を効率よく利益に変えられている状態です。');
  } else if(le(s.profitability.op,2) && ge(s.profitability.gross,4)){
    c.profitability.push('粗利は確保できていますが、販管費の重さが利益を圧迫している可能性があります。固定費の内訳（人件費・賃借料など）を見直す余地がありそうです。');
  } else if(le(s.profitability.op,2) && le(s.profitability.gross,2)){
    c.profitability.push('本業の稼ぐ力自体が弱い状態です。価格設定や原価構造から見直しが必要かもしれません。');
  } else {
    c.profitability.push('収益性の指標は概ね標準的な水準です。');
  }
  if(m.debtExcess){
    c.profitability.push('自己資本がマイナス（債務超過）のため、ROE（自己資本利益率）は算出していません。収益性より先に、安全性（自己資本比率）の改善を優先してご検討ください。');
  } else if(m.lowEquityWarning){
    c.profitability.push('自己資本が薄いため、ROE（自己資本利益率）は分母が小さく数値が振れやすい状態です。参考値としてご覧ください。');
  }

  // 安全性
  c.safety = [];
  if(m.debtExcess){
    c.safety.push('自己資本がマイナス（債務超過）の状態です。財務体質の立て直しが最優先の課題です。専門家（税理士・中小企業診断士など）への早期相談をお勧めします。');
  } else if(ge(s.safety.equity,4) && ge(s.safety.current,4)){
    c.safety.push('財務の土台はしっかりしています。急な資金繰りの悪化には強い体質です。');
  } else if(le(s.safety.equity,2) && le(s.safety.ebitdaDebt,2)){
    c.safety.push('自己資本が薄く、稼ぐ力に対して借入への依存度も高い状態です。資金調達の選択肢を広げておくことをお勧めします。');
  } else if(m.estCF!==null && m.estCF<0 && m.netIncome>0){
    c.safety.push('黒字ですが、資金の動きは苦しい可能性があります（黒字倒産リスクの兆候）。売上債権・棚卸資産の滞留を確認してください。');
  } else {
    c.safety.push('安全性の指標は概ね標準的な水準です。');
  }
  if(m.ebitda<=0){
    c.safety.push('EBITDA（本業の実質的な稼ぐ力）が赤字のため、有利子負債の返済余力は特に厳しい状態です。');
  }
  if(m.currentRatioPct===null){
    c.safety.push('流動負債が0のため、流動比率・当座比率は算出していません。');
  }

  // 効率性
  c.efficiency = [];
  if(m.cogsZeroNote){
    c.efficiency.push('売上原価が0円のため、CCC（現金化サイクル）関連の指標は算出していません。原価が発生する業態であれば、売上原価の入力をご確認ください。');
  } else if(ge(s.efficiency.ccc,4)){
    c.efficiency.push('現金化のサイクルが速く、運転資金の負担が小さい状態です。');
  } else if(le(s.efficiency.ccc,2)){
    c.efficiency.push('在庫や売上債権の回転がゆっくりで、寝ている資金がある可能性があります。棚卸資産・売掛金の内訳を確認する価値がありそうです。');
  } else {
    c.efficiency.push('資産の使い方は概ね標準的な水準です。');
  }

  // 成長性
  c.growth = [];
  if(r.scores.growth===null){
    if(m.growthUnavailableReason==='zero-baseline'){
      c.growth.push('前期の売上高・経常利益・総資産のいずれかが0円のため、成長率を算出できませんでした（総合スコアの重みは他の4カテゴリに再配分しています）。');
    } else {
      c.growth.push('1期分のみの入力のため、成長性は算出していません（総合スコアの重みは他の4カテゴリに再配分しています）。次回決算書が揃うと算出できます。');
    }
  } else {
    if(ge(s.growth.sales,4) && ge(s.growth.profit,4)){
      c.growth.push('売上・利益ともに拡大基調です。');
    } else if(ge(s.growth.sales,4) && le(s.growth.profit,2)){
      c.growth.push('売上は伸びていますが、利益が追いついていません。増収減益の傾向がないかご確認ください。');
    } else if(le(s.growth.sales,2)){
      c.growth.push('売上の伸びが鈍化・減少しています。');
    } else if(s.growth.sales===null){
      c.growth.push('売上高の成長率は算出できませんでしたが、利益・資産の成長性は概ね標準的な水準です。');
    } else {
      c.growth.push('成長性は概ね標準的な水準です。');
    }
    if(m.growthTrendNote==='up-spike'){
      c.growth.push('直近期の伸びは、それ以前と比べて急に大きくなっています。一過性の要因（特別な受注や取引など）がないか確認する価値があります。');
    } else if(m.growthTrendNote==='slowdown'){
      c.growth.push('成長ペースが以前と比べて鈍化しています。');
    }
  }

  // 生産性
  c.productivity = [];
  if(!m.hasEmployees){
    c.productivity.push('従業員数が未入力のため、総資産あたり付加価値で代替算出しています。より実態に近い比較には従業員数の入力をおすすめします。');
  } else {
    const sp = s.productivity.labor;
    if(ge(sp,4)) c.productivity.push('従業員一人あたりの稼ぐ力は高い水準です。');
    else if(le(sp,2)) c.productivity.push('従業員一人あたりの付加価値は平均を下回っています。業務の効率化や単価の見直しが選択肢になりそうです。');
    else c.productivity.push('生産性は概ね標準的な水準です。');
  }

  return c;
}

/* ===================== 画面：入力フォーム生成 ===================== */
function fieldGroupHTML(prefix, fields, half){
  return fields.map(f=>{
    const cls = f.sub ? 'field sub-field' : 'field';
    return `<div class="${cls}"><label>${f.l}</label><input type="number" data-key="${f.k}" id="${prefix}_${f.k}"></div>`;
  }).join('');
}

function buildPeriodPanel(idx){
  const div = document.createElement('div');
  div.className = 'period-panel';
  div.id = 'panel-'+idx;
  div.innerHTML = `
    <div class="subgroup">貸借対照表（B/S）</div>
    <div class="mini-grid">${fieldGroupHTML('p'+idx+'_bs', BS_FIELDS)}</div>
    <div class="subgroup">損益計算書（P/L）</div>
    <div class="mini-grid">${fieldGroupHTML('p'+idx+'_pl', PL_FIELDS)}</div>
