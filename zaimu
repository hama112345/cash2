<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>財務みはらし｜決算書から、経営の実りを見晴らす</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<style>
  :root{
    --ink:#1F2D3D; --ink-soft:#3A4C60; --gold:#C9A227; --gold-deep:#93761A;
    --paper:#F5F1E8; --paper-deep:#EDE6D4; --moss:#5C7452; --moss-deep:#3F5138;
    --charcoal:#2B2823; --line:rgba(31,45,61,0.14); --white:#FFFDF8;
    --steel:#4B6E8C; --wine:#8C4B6E; --ochre:#A6763A; --warn:#B4552B; --danger:#9B3B3B;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--charcoal);font-family:'Zen Kaku Gothic New',sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased;}
  h1,h2,h3,.serif{font-family:'Shippori Mincho',serif;color:var(--ink);margin:0;letter-spacing:0.02em;}
  input,select,button{font-family:inherit;}
  .app{max-width:1320px;margin:0 auto;padding:0 24px 80px;}

  header.top{position:sticky;top:0;z-index:50;background:rgba(245,241,232,0.94);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);margin-bottom:28px;}
  .top-inner{max-width:1320px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
  .brand{display:flex;align-items:center;gap:10px;}
  .brand-mark{width:32px;height:32px;border-radius:50%;background:var(--ink);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .brand-mark svg{width:16px;height:16px;}
  .brand-name{font-family:'Shippori Mincho',serif;font-size:18px;font-weight:700;color:var(--ink);}
  .brand-sub{font-size:12px;color:#75705F;margin-top:1px;}
  .free-pill{font-size:12px;color:var(--moss-deep);border:1px solid var(--moss);border-radius:999px;padding:4px 12px;white-space:nowrap;}

  .layout{display:grid;grid-template-columns:420px 1fr;gap:28px;align-items:start;}
  @media (max-width:980px){.layout{grid-template-columns:1fr;}}

  .panel{background:var(--white);border:1px solid var(--line);border-radius:6px;}
  .panel-pad{padding:22px;}
  .input-panel{position:sticky;top:88px;}
  @media (max-width:980px){.input-panel{position:static;}}

  .block-title{font-size:12.5px;color:var(--moss-deep);letter-spacing:0.08em;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
  .block-title::before{content:"";width:16px;height:1px;background:var(--moss-deep);display:inline-block;}

  .field-row{display:flex;gap:10px;margin-bottom:12px;}
  .field{flex:1;}
  .field label{display:block;font-size:11.5px;color:#8A8471;margin-bottom:5px;}
  .field select,.field input{width:100%;padding:8px 9px;font-size:13px;border:1px solid var(--line);border-radius:3px;background:var(--white);color:var(--charcoal);}
  .field input:focus,.field select:focus{outline:2px solid var(--gold);outline-offset:0;}

  .tabs{display:flex;gap:4px;margin:18px 0 12px;border-bottom:1px solid var(--line);}
  .tab-btn{border:none;background:none;padding:9px 14px;font-size:13px;color:#8A8471;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;}
  .tab-btn.active{color:var(--ink);border-bottom-color:var(--gold-deep);font-weight:700;}
  .period-panel{display:none;}
  .period-panel.active{display:block;}

  .unit-note{font-size:11px;color:#8A8471;margin-bottom:14px;}
  .subgroup{font-size:12px;font-weight:700;color:var(--ink-soft);margin:14px 0 8px;}
  .mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px;}
  .mini-grid .field label{font-size:11px;}
  .mini-grid .sub-field label{padding-left:10px;color:#9C9680;}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 20px;border-radius:4px;font-size:14.5px;font-weight:700;cursor:pointer;border:1px solid transparent;width:100%;margin-top:18px;transition:transform .15s,background .2s;}
  .btn-primary{background:var(--ink);color:var(--white);}
  .btn-primary:hover{transform:translateY(-1px);background:var(--ink-soft);}

  .output-panel{min-height:520px;}
  .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:480px;padding:40px;color:#8A8471;}
  .empty-state svg{width:44px;height:44px;color:#B7AE95;margin-bottom:16px;}
  .empty-state p{font-size:14px;max-width:340px;margin:0;}

  .report{padding:28px 30px 34px;}
  .report-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:6px;}
  .report-head .company{font-size:13px;color:var(--ink-soft);margin-bottom:4px;}
  .report-head h2{font-size:24px;font-weight:700;}
  .badge-block{text-align:right;}
  .badge{font-family:'Shippori Mincho',serif;font-size:34px;font-weight:700;line-height:1;padding:6px 0;}
  .badge-meaning{font-size:12px;color:var(--ink-soft);margin-top:4px;}
  .total-score{font-size:12px;color:#8A8471;margin-top:2px;}

  .disclaimer-fixed{background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:10px 14px;font-size:12px;color:var(--ink-soft);margin:16px 0 22px;}

  .alert-line{display:flex;align-items:flex-start;gap:9px;border-radius:4px;padding:11px 13px;margin-bottom:10px;font-size:12.5px;line-height:1.6;}
  .alert-line svg{width:16px;height:16px;flex-shrink:0;margin-top:2px;}
  .alert-warn{background:rgba(180,85,43,0.09);border:1px solid rgba(180,85,43,0.35);color:#8A4222;}
  .alert-danger{background:rgba(155,59,59,0.09);border:1px solid rgba(155,59,59,0.35);color:#7A2F2F;}
  .alert-info{background:rgba(75,110,140,0.09);border:1px solid rgba(75,110,140,0.3);color:#33526D;}

  .axis-wrap{background:var(--ink);border-radius:6px;padding:26px 26px 20px;margin:22px 0;}
  .ears{display:flex;align-items:flex-end;justify-content:space-between;height:150px;padding:0 4px 8px;border-bottom:1px solid rgba(255,253,248,0.16);}
  .ear{width:17%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:6px;}
  .ear .val{font-size:12px;color:#EFE9D8;font-weight:700;}
  .ear .stalk{width:26px;border-radius:3px 3px 0 0;transition:height .4s ease;}
  .ear-labels{display:flex;justify-content:space-between;margin-top:10px;padding:0 4px;}
  .ear-labels span{width:17%;text-align:center;font-size:11px;color:#B9C3CE;}
  .ear-labels .na{color:#75808C;}

  .legend-row{display:flex;gap:14px;flex-wrap:wrap;margin:18px 0 26px;padding:14px 16px;background:var(--paper);border:1px solid var(--line);border-radius:4px;}
  .legend-item{font-size:11.5px;color:var(--ink-soft);display:flex;align-items:center;gap:6px;}
  .legend-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}

  .cat-cards{display:flex;flex-direction:column;gap:14px;}
  .cat-card{border:1px solid var(--line);border-radius:5px;overflow:hidden;}
  .cat-head{display:flex;align-items:center;justify-content:space-between;padding:13px 18px;cursor:pointer;background:var(--paper);}
  .cat-head-left{display:flex;align-items:center;gap:10px;}
  .cat-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
  .cat-head h3{font-size:15px;font-weight:700;}
  .cat-weight{font-size:11px;color:#8A8471;}
  .cat-score{font-family:'Shippori Mincho',serif;font-size:19px;font-weight:700;color:var(--ink);}
  .cat-score small{font-size:11px;font-weight:400;color:#8A8471;}
  .cat-body{padding:16px 18px 18px;background:var(--white);border-top:1px solid var(--line);display:none;}
  .cat-card.open .cat-body{display:block;}
  .cat-card.open .chev{transform:rotate(180deg);}
  .chev{transition:transform .2s;color:#8A8471;width:16px;height:16px;flex-shrink:0;}

  .metric-table{width:100%;border-collapse:collapse;font-size:12.5px;margin-bottom:14px;}
  .metric-table th{text-align:left;font-weight:500;color:#8A8471;font-size:11px;padding:6px 8px;border-bottom:1px solid var(--line);}
  .metric-table td{padding:7px 8px;border-bottom:1px solid var(--line);}
  .metric-table td.num{text-align:right;font-variant-numeric:tabular-nums;}
  .score-pill{display:inline-block;min-width:26px;text-align:center;border-radius:3px;padding:2px 6px;font-size:11.5px;font-weight:700;color:#fff;}

  .comment-box{border-left:2px solid var(--gold-deep);padding-left:13px;margin-top:10px;font-size:13.5px;color:var(--ink-soft);}
  .comment-box p{margin:0 0 6px;}
  .note-line{font-size:11.5px;color:#8A8471;margin-top:8px;}

  .assumption-box{margin-top:26px;padding-top:20px;border-top:1px solid var(--line);}
  .assumption-box h4{font-size:12px;font-weight:700;color:#8A8471;margin:0 0 10px;letter-spacing:0.04em;}
  .assumption-box ul{margin:0;padding-left:16px;}
  .assumption-box li{font-size:12px;color:#8A8471;margin-bottom:6px;line-height:1.6;}

  .balance-warn{margin-bottom:10px;}

  /* ---- 決算書ファイル取込 ---- */
  .import-box{border:1px solid var(--line);border-radius:5px;background:var(--paper);padding:14px 14px 16px;margin-bottom:22px;}
  .import-hint{font-size:11.5px;color:#8A8471;line-height:1.6;margin-bottom:10px;}
  .privacy-note{font-size:11px;color:#8A8471;line-height:1.5;margin-top:8px;padding-top:8px;border-top:1px solid #E4DFD2;}
  .field-note{font-size:11px;color:#8A8471;line-height:1.5;margin-top:4px;}
  .import-filerow{margin-bottom:10px;}
  .import-filerow input[type="file"]{width:100%;font-size:12px;color:var(--ink-soft);background:var(--white);border:1px solid var(--line);border-radius:3px;padding:8px;}
  .import-options{display:flex;gap:8px;margin-bottom:10px;}
  .import-options .field{flex:1;}
  .import-options label{display:block;font-size:11px;color:#8A8471;margin-bottom:4px;}
  .import-options select{width:100%;padding:7px 8px;font-size:12px;border:1px solid var(--line);border-radius:3px;background:var(--white);color:var(--charcoal);}
  .btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:10px 16px;border-radius:4px;font-size:13px;font-weight:700;cursor:pointer;border:1px solid var(--ink);background:var(--white);color:var(--ink);transition:background .15s,color .15s;}
  .btn-secondary:hover{background:var(--ink);color:var(--white);}
  .btn-secondary:disabled{opacity:0.5;cursor:not-allowed;}
  .import-status{margin-top:12px;font-size:12px;color:var(--ink-soft);line-height:1.7;}
  .import-status .ok{color:var(--moss-deep);font-weight:700;}
  .import-status .warn{color:var(--warn);font-weight:700;}
  .import-status ul{margin:6px 0 0;padding-left:18px;}
  .import-status li{margin-bottom:3px;}
  .import-filelist{font-size:11px;color:#8A8471;margin:2px 0 10px;}
</style>
</head>
<body>

<header class="top">
  <div class="top-inner">
    <div class="brand">
      <div class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="#FFFDF8" stroke-width="1.6"><path d="M12 3c0 6-4 8-4 13a4 4 0 008 0c0-5-4-7-4-13z"/></svg></div>
      <div>
        <div class="brand-name">財務みはらし</div>
        <div class="brand-sub">決算書の数字を、経営の実りに変える</div>
      </div>
    </div>
  </div>
</header>

<div class="app">
  <div class="layout">

    <!-- INPUT PANEL -->
    <aside class="panel input-panel">
      <div class="panel-pad">
        <div class="block-title">決算書ファイルから自動入力</div>
        <div class="import-box">
          <div class="import-hint">PDF（テキストが選択できるデータ）またはExcel／CSVの決算書を読み込むと、下の入力欄に自動反映します。複数期分が1枚の表にまとまっているファイルはまとめて解析します。複数ファイルを選ぶ場合は、<b>古い期→新しい期の順</b>に選択してください。自動抽出はあくまで下書きです。反映後は必ず金額を確認・修正してから診断してください。</div>
          <div class="import-filerow">
            <input type="file" id="importFileInput" accept=".pdf,.xlsx,.xls,.csv" multiple>
          </div>
          <div class="import-options">
            <div class="field">
              <label>ファイル内の金額単位</label>
              <select id="importUnit">
                <option value="1">円</option>
                <option value="1000" selected>千円</option>
                <option value="1000000">百万円</option>
              </select>
            </div>
            <div class="field">
              <label>表内の列の並び</label>
              <select id="importOrder">
                <option value="new-right" selected>新しい期が右</option>
                <option value="new-left">新しい期が左</option>
              </select>
            </div>
          </div>
          <button class="btn-secondary" id="importRunBtn" type="button">読み込んでフォームに反映</button>
          <div class="import-status" id="importStatus"></div>
          <div class="privacy-note">🔒 入力・アップロードした内容はお使いのブラウザ内でのみ処理されます。外部サーバーへ送信・保存されることはありません。</div>
        </div>

        <div class="block-title">基本情報</div>
        <div class="field-row">
          <div class="field"><label>会社名</label><input type="text" id="companyName" placeholder="例：〇〇製作所"></div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>業種</label>
            <select id="industry"></select>
            <div class="field-note" id="industryFieldNote">※業種の選択肢と基準値は、中小企業庁「中小企業実態基本調査」のデータを基に自動生成しています。</div>
          </div>
          <div class="field"><label>従業員数（任意）</label><input type="number" id="employees" placeholder="例：28"></div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>決算期数</label>
            <select id="periodCount">
              <option value="1">1期分のみ</option>
              <option value="2">2期分</option>
              <option value="3" selected>3期分（推奨）</option>
            </select>
          </div>
        </div>

        <div class="block-title" style="margin-top:20px;">決算書の数値を入力</div>
        <div class="unit-note">単位：千円。多少の科目のズレは近い金額で概算入力してかまいません。</div>
        <div class="tabs" id="tabBar"></div>
        <div id="periodPanels"></div>

        <button class="btn btn-primary" id="diagnoseBtn">この内容で診断する</button>
      </div>
    </aside>

    <!-- OUTPUT PANEL -->
    <section class="panel output-panel" id="outputPanel">
      <div class="empty-state" id="emptyState">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3v18M9 3h9a2 2 0 012 2v9l-5 5H9"/><path d="M9 3H6a2 2 0 00-2 2v14a2 2 0 002 2h3"/></svg>
        <p>決算書ファイルを読み込むか、数字を直接入力して「この内容で診断する」を押してください。5つの観点からスコアと、その意味合いをレポートとして出力します。</p>
      </div>
      <div id="reportRoot"></div>
    </section>

  </div>
</div>

<script>
/* ===================== 定数・スコアバンド ===================== */
const BANDS = {
  gross:[40,30,20,10], op:[10,7,4,1], roa:[8,5,3,1], roe:[15,10,5,0],
  equity:[40,30,20,10], current:[200,150,120,100], quick:[150,100,80,50],
  fixedLT:[80,100,120,150], ebitdaDebt:[5,10,15,20], turnover:[1.5,1.2,0.8,0.5],
  ccc:[30,60,90,120], prodHead:[800,600,400,200], prodAsset:[30,20,12,6],
  growth:[10,5,0,-5],
};
/* ===================== 業種別ベンチマークデータ ===================== */
// 出典：中小企業庁「中小企業実態基本調査」令和５年速報（令和４年度決算実績、令和6年3月29日公表）
//   経済産業省 報道発表資料（要旨）: https://www.meti.go.jp/press/2023/03/20240329008/20240329008-1r.pdf
//   産業大分類・11区分（日本標準産業分類ベース）。速報値のため、確報公表時に数値が更新される場合がある。
//
// 反映している指標（実データに基づき業種差を補正）：
//   ・opMarginRatio … 「売上高経常利益率」の対全産業加重平均比。本アプリの sOp（売上高営業利益率）
//     の基準値をこの比率で補正している。公式統計は営業利益ベースの産業別集計を公表していないため、
//     経常利益ベースの数値を近似値として利用している（両者は非常に近い値になることが多いが、
//     支払利息・受取利息等の非経常項目が大きい業種では乖離しうる点に留意）。
//   ・prodRatio … 「従業者１人当たり付加価値額」の対全産業平均比。生産性カテゴリの基準値を補正している。
//
// 未反映の指標：自己資本比率・総資産回転率・売上高総利益率・ROA・ROEは、産業大分類別の公式数値を
// 安全に取得できなかったため、現状は全業種共通の基準（BANDS）のまま。次回更新時に対応候補。
//
// ---- 年次更新の手順（年1回、確報公表後を想定）----
// 1. 中小企業庁「中小企業実態基本調査」ページで最新の確報／速報の要旨PDFを確認
//    https://www.chusho.meti.go.jp/koukai/chousa/kihon/index.html
// 2. PDF内「Ⅱ 主要項目の調査結果」の産業大分類別グラフから、業種ごとの
//    「１企業当たり売上高」「１企業当たり経常利益」「従業者１人当たり付加価値額」を読み取る
// 3. 巻末「付録 経営指標」の全産業加重平均値（売上高経常利益率・付加価値比率）を読み取る
// 4. 下のINDUSTRY_RAW_DATAの該当値を置き換える（比率はbuildIndustryBenchmarksが自動計算）
// 5. dataYearとsourceUrlのコメントも忘れずに更新する
const INDUSTRY_RAW_DATA = {
  dataYear: '令和4年度決算実績（令和5年速報、令和6年3月29日公表）',
  sourceUrl: 'https://www.meti.go.jp/press/2023/03/20240329008/20240329008-1r.pdf',
  allIndustryOpMarginPct: 4.29,     // 全産業加重平均：売上高経常利益率（％、公式値）
  allIndustryLaborProdManYen: 598,  // 全産業加重平均：従業者1人当たり付加価値額（万円、公式値）
  // salesM / ordinaryProfitM は1企業当たり（百万円）、laborProdManYenは従業者1人当たり付加価値額（万円）
  industries: {
    "建設業":                       {salesM:201.6, ordinaryProfitM:11.1, laborProdManYen:690},
    "製造業":                       {salesM:410.9, ordinaryProfitM:21.6, laborProdManYen:660},
    "情報通信業":                   {salesM:255.5, ordinaryProfitM:16.7, laborProdManYen:660},
    "運輸業，郵便業":               {salesM:457.5, ordinaryProfitM:8.9,  laborProdManYen:570},
    "卸売業":                       {salesM:841.8, ordinaryProfitM:22.8, laborProdManYen:750},
    "小売業":                       {salesM:155.6, ordinaryProfitM:4.8,  laborProdManYen:410},
    "不動産業，物品賃貸業":         {salesM:123.5, ordinaryProfitM:14.1, laborProdManYen:1540},
    "学術研究，専門・技術サービス業":{salesM:69.9,  ordinaryProfitM:9.2,  laborProdManYen:670},
    "宿泊業，飲食サービス業":       {salesM:32.6,  ordinaryProfitM:1.3,  laborProdManYen:240},
    "生活関連サービス業，娯楽業":   {salesM:61.8,  ordinaryProfitM:2.9,  laborProdManYen:460},
    "サービス業（他に分類されないもの）":{salesM:173.2,ordinaryProfitM:8.0, laborProdManYen:400},
  }
};
// 生データから「基準値に対する比率」を算出する。業種を追加・更新する際もこの関数は変更不要。
function buildIndustryBenchmarks(raw){
  const out = {
    "選択しない": {label:'選択しない（全業種加重平均で比較）', opMarginRatio:1, prodRatio:1, refOpMarginPct:raw.allIndustryOpMarginPct, refLaborProdManYen:raw.allIndustryLaborProdManYen},
  };
  Object.keys(raw.industries).forEach(name=>{
    const d = raw.industries[name];
    const opMarginPct = d.salesM>0 ? d.ordinaryProfitM/d.salesM*100 : null;
    out[name] = {
      label: name,
      opMarginRatio: opMarginPct!==null ? opMarginPct/raw.allIndustryOpMarginPct : 1,
      prodRatio: d.laborProdManYen/raw.allIndustryLaborProdManYen,
      refOpMarginPct: opMarginPct,
      refLaborProdManYen: d.laborProdManYen,
    };
  });
  return out;
}
const INDUSTRY_BENCHMARKS = buildIndustryBenchmarks(INDUSTRY_RAW_DATA);
const CAT_COLOR = {profitability:'#C9A227', safety:'#5C7452', efficiency:'#4B6E8C', growth:'#8C4B6E', productivity:'#A6763A'};
const CAT_LABEL = {profitability:'収益性', safety:'安全性', efficiency:'効率性', growth:'成長性', productivity:'生産性'};
const BADGE_COLOR = {S:'#93761A', A:'#3F5138', 'B+':'#33526D', B:'#A6763A', C:'#B4552B', D:'#9B3B3B'};
const BADGE_MEANING = {
  S:'極めて良好な財務体質です。強みとして積極的に打ち出せる水準です。',
  A:'良好な水準です。大きな弱点は見当たりません。',
  'B+':'やや良好〜標準的な水準です。伸ばせる余地のある分野があります。',
